/// PLACEHOLDER. One row per census tract: households, estimated unbanked households, scores, pilot arm.
table dim_tract
	lineageTag: ec41c553-9460-577c-b407-cbe14b1a9dee
	sourceLineageTag: [dbo].[dim_tract]

	measure Tracts = COUNTROWS(dim_tract)
		formatString: #,0
		displayFolder: Opportunity
		lineageTag: 4ea9a505-5143-5df2-afff-f46fe46e2beb

	measure Households = SUM(dim_tract[households])
		formatString: #,0
		displayFolder: Community
		lineageTag: 6a3e7c89-70be-5709-a889-11f03379c593

	measure 'Est. Unbanked Households' = SUM(dim_tract[est_unbanked_households])
		formatString: #,0
		displayFolder: Community
		lineageTag: 4134b365-440b-5435-94ac-2faa4c196494

	measure 'Est. Underbanked Households' = SUM(dim_tract[est_underbanked_households])
		formatString: #,0
		displayFolder: Community
		lineageTag: 004d0213-3aaa-522e-84cc-f835c8679df3

	measure 'Avg Need Score' = AVERAGE(dim_tract[need_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: b81c2352-b770-5800-88f2-ba8524b9b5e1

	measure 'Avg Readiness Score' = AVERAGE(dim_tract[readiness_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: 4ffba171-604c-5ec3-8957-0fa8dfaf6e83

	measure 'Avg Bank Fit Score' = AVERAGE(dim_tract[bank_fit_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: c5ef73fa-ef44-531c-a8a6-67abeca12385

	measure 'Avg Opportunity Score' = AVERAGE(dim_tract[opportunity_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: d053207b-40f8-5b0a-ba36-818dba2130c6

