# Copy to config.env (git ignores it) and fill in. No secrets go here: sign-in comes from `az login`.

# Azure subscription and existing resource group the Fabric capacity is created in.
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=rg-dapa-dev
LOCATION=eastus

# Fabric capacity: lowercase letters and digits only. F2 is the smallest size; pause it when idle.
CAPACITY_NAME=dapafabricdev
CAPACITY_SKU=F2
# Comma-separated sign-in emails who can manage the capacity. Keep this list short.
CAPACITY_ADMINS=you@yourorg.com

# Fabric workspace that holds the lakehouse, notebook, models and reports.
WORKSPACE_NAME=DAPA Dev
# Optional: comma-separated teammates to add as workspace admins. The person deploying is added automatically.
WORKSPACE_ADMINS=
