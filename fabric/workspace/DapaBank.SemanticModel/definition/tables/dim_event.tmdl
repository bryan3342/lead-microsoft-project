/// PLACEHOLDER. Community events run by the bank.
table dim_event
	lineageTag: a81f49f2-a698-58eb-8300-702aa3a5edc6
	sourceLineageTag: [dbo].[dim_event]

	measure Events = COUNTROWS(dim_event)
		formatString: #,0
		displayFolder: Pilot
		lineageTag: 48472aa7-d57b-5e1d-96f3-13602ffd94e9

	measure 'Event Cost' = SUM(dim_event[cost_usd])
		formatString: \$#,0
		displayFolder: Pilot
		lineageTag: 44262514-36e2-574e-afbf-a5b81aa613e3

	measure 'Cost per Active Customer' = DIVIDE([Event Cost], [Active 90 Days])
		formatString: \$#,0
		displayFolder: Pilot
		lineageTag: 9d0a1b92-b3c4-55ca-9183-cafa8c5ef650

