/// Bank branches with location and tract.
table dim_branch
	lineageTag: 03f2be00-48be-528c-9f1a-e3c1660892fe
	sourceLineageTag: [dbo].[dim_branch]

	measure Branches = COUNTROWS(dim_branch)
		formatString: #,0
		displayFolder: Branches
		lineageTag: 3fceac75-7b5b-5ed3-afc7-75988edfbb0d

	measure 'Target Issuer Branches' = CALCULATE([Branches], dim_bank[target_issuer] = TRUE())
		formatString: #,0
		displayFolder: Branches
		lineageTag: 68a17815-66db-5b99-b44b-48a6e54661cf

	column uninum
