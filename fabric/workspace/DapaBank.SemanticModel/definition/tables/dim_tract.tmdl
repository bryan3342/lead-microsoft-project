/// One row per census tract with need, readiness and bank-fit scores (SAMPLE data).
table dim_tract
	lineageTag: ec41c553-9460-577c-b407-cbe14b1a9dee
	sourceLineageTag: [dbo].[dim_tract]

	measure Tracts = COUNTROWS(dim_tract)
		formatString: #,0
		displayFolder: Opportunity
		lineageTag: 4ea9a505-5143-5df2-afff-f46fe46e2beb

	measure 'Avg Need Score' = AVERAGE(dim_tract[need_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: b81c2352-b770-5800-88f2-ba8524b9b5e1

	measure 'Avg Readiness Score' = AVERAGE(dim_tract[readiness_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: 4ffba171-604c-5ec3-8957-0fa8dfaf6e83

	measure 'Avg Bank Fit Score' = AVERAGE(dim_tract[bank_fit_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: c5ef73fa-ef44-531c-a8a6-67abeca12385

	measure 'Avg Opportunity Score' = AVERAGE(dim_tract[opportunity_score])
		formatString: 0.00
		displayFolder: Opportunity
		lineageTag: d053207b-40f8-5b0a-ba36-818dba2130c6

	measure 'Active Accounts per 1k Adults' = DIVIDE(SUM(dim_tract[observed_new_active_accounts]), SUM(dim_tract[adult_population])) * 1000
		formatString: 0.0
		displayFolder: Pilot vs control
		lineageTag: a65da4e5-b9e1-541b-998a-96abdc658bc5

	measure 'Lift vs Control' =
			VAR pilot = CALCULATE([Active Accounts per 1k Adults], dim_tract[pilot_arm] IN {"Pilot A", "Pilot B"})
			VAR control = CALCULATE([Active Accounts per 1k Adults], dim_tract[pilot_arm] = "Control")
			RETURN pilot - control
		formatString: +0.0;-0.0;0.0
		displayFolder: Pilot vs control
		lineageTag: 8d8bf5f8-401f-511a-a9eb-89db5e2238d1

