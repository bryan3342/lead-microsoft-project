/// De-identified aggregate for Mastercard. Groups under 10 attendees suppressed upstream.
table agg_playbook
	lineageTag: fe91a6a5-27b3-50ca-a243-6ef1b30f1257
	sourceLineageTag: [dbo].[agg_playbook]

	measure 'Total Events' = SUM(agg_playbook[events])
		formatString: #,0
		displayFolder: Results
		lineageTag: 2537f319-a54e-57e8-b9c0-7acd3239244f

	measure 'Total Registrations' = SUM(agg_playbook[registrations])
		formatString: #,0
		displayFolder: Results
		lineageTag: f01dd833-35db-589c-855f-b32019e2bd1c

	measure 'Total Attendees' = SUM(agg_playbook[attendees])
		formatString: #,0
		displayFolder: Results
		lineageTag: 0782289c-da44-57a8-9644-9b9f1343b441

	measure 'Accounts Opened' = SUM(agg_playbook[accounts_opened])
		formatString: #,0
		displayFolder: Results
		lineageTag: 83aa4bfc-a889-54c7-bc0c-010f49d4b54c

	measure 'Active 90 Days' = SUM(agg_playbook[active_90d])
		formatString: #,0
		displayFolder: Results
		lineageTag: 138fd390-2ed8-5ccf-a954-f194930d39ca

	measure 'Attendance Rate' = DIVIDE([Total Attendees], [Total Registrations])
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: 39f9a957-e776-5ae3-a4bb-03114cff2ed3

	measure 'Open Rate' = DIVIDE([Accounts Opened], SUM(agg_playbook[matched_attendees]))
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: 9c746997-1238-5b1e-a4f1-15ce23285f76

	measure 'Active Rate' = DIVIDE([Active 90 Days], [Accounts Opened])
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: db312432-4e9b-5072-8f44-274efe551880

	measure 'Cost per Active Customer' = DIVIDE(SUM(agg_playbook[cost_usd]), [Active 90 Days])
		formatString: \$#,0
		displayFolder: Rates
		lineageTag: 2bb9d056-0d18-5241-aca9-882231fc841e

	measure 'Avg Trust Lift' = DIVIDE(SUM(agg_playbook[trust_lift_sum]), SUM(agg_playbook[survey_responses]))
		formatString: +0.00;-0.00;0.00
		displayFolder: Rates
		lineageTag: 7e5b8f54-d9fb-53b6-a01a-16fa50898bb0

