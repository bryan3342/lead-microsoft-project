/// Cumulative lifetime value per new customer by scenario and year, from the LTV model inputs.
table scenario_ltv
	lineageTag: 668ca843-6b69-5808-8980-29addb7bff8c
	sourceLineageTag: [dbo].[scenario_ltv]

	measure 'LTV per Customer (Conservative)' = CALCULATE(SUM(scenario_ltv[cumulative_ltv_usd]), scenario_ltv[scenario] = "Conservative")
		formatString: \$#,0
		displayFolder: Cost vs LTV
		lineageTag: c4b838a7-1129-5704-a028-5969fac76888

	measure 'LTV per Customer (Base)' = CALCULATE(SUM(scenario_ltv[cumulative_ltv_usd]), scenario_ltv[scenario] = "Base")
		formatString: \$#,0
		displayFolder: Cost vs LTV
		lineageTag: 851395af-8f81-53d4-891c-f99607feb5ca

	measure 'LTV per Customer (Optimistic)' = CALCULATE(SUM(scenario_ltv[cumulative_ltv_usd]), scenario_ltv[scenario] = "Optimistic")
		formatString: \$#,0
		displayFolder: Cost vs LTV
		lineageTag: 86895e4d-87f3-5a1c-8d6b-212237ecd23a

	measure 'Acquisition Cost per Customer' = AVERAGE(scenario_ltv[acquisition_cost_usd])
		formatString: \$#,0
		displayFolder: Cost vs LTV
		lineageTag: 86ff1d0f-8f17-50db-8aef-56c6480255d1

	column scenario
		dataType: string
		lineageTag: 249f95d7-7432-5265-894c-350e1fc929c8
		sourceLineageTag: scenario
		summarizeBy: none
		sourceColumn: scenario

	column year
		dataType: int64
		formatString: 0
		lineageTag: 22789255-14e1-5719-89d5-cc684ceb5f15
		sourceLineageTag: year
		summarizeBy: none
		sourceColumn: year

	column cumulative_ltv_usd
		dataType: double
		formatString: \$#,0
		lineageTag: c6e45df4-ef70-5d28-8a71-05d3ab75dde4
		sourceLineageTag: cumulative_ltv_usd
		summarizeBy: none
		sourceColumn: cumulative_ltv_usd

	column acquisition_cost_usd
		dataType: double
		formatString: \$#,0
		lineageTag: 869feb31-62f8-5bad-a007-d217e6c8df51
		sourceLineageTag: acquisition_cost_usd
		summarizeBy: none
		sourceColumn: acquisition_cost_usd

	column basis
		dataType: string
		lineageTag: 9e4ffccc-f9d4-5948-b102-09075f507ec8
		sourceLineageTag: basis
		summarizeBy: none
		sourceColumn: basis

	partition scenario_ltv = entity
		mode: directLake
		source
			entityName: scenario_ltv
			schemaName: dbo
			expressionSource: DatabaseQuery
